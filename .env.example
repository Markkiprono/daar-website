# ------------------------------------------------------------
#  DAAR — environment template
#  Copy to .env and fill in. Never commit the real .env.
# ------------------------------------------------------------

# Postgres. Same engine in dev and prod — no SQLite anywhere.
# Local dev:  postgresql://postgres:PASSWORD@localhost:5432/daar?schema=public
# Production: your VPS Postgres, or a managed instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/daar?schema=public"

# Public origin, no trailing slash.
# dev:  http://localtest.me:3000   (resolves to 127.0.0.1, no setup needed)
# prod: https://daarbyizzi.com
NEXT_PUBLIC_SITE_URL="http://localtest.me:3000"

# Host that serves the admin dashboard. Sessions are scoped to this
# host only, so a public visitor never carries an admin cookie.
# dev:  admin.localtest.me:3000
# prod: admin.daarbyizzi.com
#
# Note: admin.localhost does NOT resolve on Windows. If you'd rather not
# depend on the public localtest.me domain, add this to
# C:\Windows\System32\drivers\etc\hosts (needs admin rights) and use
# admin.localhost:3000 instead:
#     127.0.0.1  admin.localhost
ADMIN_HOST="admin.localtest.me:3000"

# Currency shown across the site. Single source of truth.
NEXT_PUBLIC_CURRENCY="KES"

# --- Phase 2: auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- Phase 2: image storage (S3-compatible) ---
# Works with Cloudflare R2, MinIO on the VPS, or any S3 API.
# Deliberately not Vercel Blob, so the app is not platform-locked.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="daar-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
