// ============================================================
//  DAAR Cafe & Bakery — data model
//  Postgres in dev and prod (same engine everywhere).
//  Connection URL lives in prisma.config.ts (Prisma 7 convention).
// ============================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
//  MENU
// ------------------------------------------------------------

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  items        MenuItem[]

  /// Optional marketing photo for the category tile on the home page. When
  /// unset, categoryImage() in src/lib/menu.ts keeps borrowing a photo from
  /// one of the category's items, so tiles look the same until one is set.
  imageUrl    String?
  imageAlt    String?
  imageWidth  Int?
  imageHeight Int?
  blurDataUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([displayOrder])
}

model MenuItem {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  /// Stored in minor units (cents) to avoid float rounding.
  /// Rendered as whole shillings by default — see src/lib/config.ts
  priceCents Int

  /// Image lives in blob storage. Dimensions + blur placeholder are
  /// captured at upload so the menu never shifts layout on a phone.
  imageUrl    String?
  imageAlt    String?
  imageWidth  Int?
  imageHeight Int?
  blurDataUrl String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  isAvailable  Boolean @default(true)
  isFeatured   Boolean @default(false) // drives "Chef's Special" on the home page
  /// Ticked in the dashboard to put this item's photograph in the drifting
  /// band on the home page ("What today looks like").
  ///
  /// Off by default, and the band falls back to a random draw while nothing
  /// is ticked — so this changes nothing until somebody chooses. Ticking one
  /// item takes the band over completely, which is the point: the café picks
  /// what is on the counter today rather than the page guessing.
  isInBand     Boolean @default(false)
  displayOrder Int     @default(0)

  tags           MenuItemTag[]
  optionGroups   MenuItemOptionGroup[]
  offeredOptions MenuItemOptionChoice[]
  views          MenuItemView[]
  stats          DailyItemStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, displayOrder])
  @@index([isAvailable])
  @@index([isFeatured])
  @@index([isInBand])
}

enum TagKind {
  DIETARY // vegetarian, vegan, gluten-free
  BADGE // bestseller, new, seasonal, limited
}

model Tag {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  kind     TagKind @default(BADGE)
  /// Optional hex override; falls back to the design tokens.
  colorHex String?

  items     MenuItemTag[]
  createdAt DateTime      @default(now())

  @@index([kind])
}

model MenuItemTag {
  menuItemId String
  tagId      String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([menuItemId, tagId])
  @@index([tagId])
}

// ------------------------------------------------------------
//  ITEM OPTIONS
//  One item, one photo, several prices. A cappuccino is still a
//  cappuccino whether the beans are Kenyan or Brazilian, so those live
//  here as choices rather than as separate menu items with the same
//  photograph.
//
//  Groups are shared: "Extras" is defined once and ticked onto every
//  item it applies to, so adding "extra avocado" reaches all of them at
//  once and cannot drift to a different price on one sandwich.
//
//  Nothing here is ever ordered or paid for — the menu has no cart. The
//  customer builds a price on the item page, sees it, and orders at the
//  counter. Selections are browser-only and die with the page.
// ------------------------------------------------------------

enum OptionPricing {
  /// Added to the item's base price: caramel +80.
  SURCHARGE
  /// Replaces the base price: a large is 420, not "regular plus 120".
  ABSOLUTE
}

enum OptionSelect {
  /// Radio. You cannot have Kenyan and Brazilian beans in one cup.
  ONE
  /// Checkbox. Extra egg and extra cheese, both at once.
  MANY
}

model OptionGroup {
  id      String        @id @default(cuid())
  name    String // "Coffee beans", "Flavour", "Extras"
  slug    String        @unique
  select  OptionSelect  @default(ONE)
  pricing OptionPricing @default(SURCHARGE)

  /// Sits under the group heading on the item page, e.g. "Choose your origin".
  helpText String?

  displayOrder Int @default(0)

  options Option[]
  items   MenuItemOptionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
}

model Option {
  id      String      @id @default(cuid())
  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String // "Brazil", "Caramel", "Extra egg"

  /// Minor units, like MenuItem.priceCents. Read according to the group's
  /// pricing mode: added to the base under SURCHARGE, replacing it under
  /// ABSOLUTE. Zero is legitimate — the house bean costs nothing extra.
  priceCents Int @default(0)

  displayOrder Int     @default(0)
  isAvailable  Boolean @default(true)

  offeredOn MenuItemOptionChoice[]

  @@index([groupId, displayOrder])
}

/// Which groups apply to which items. displayOrder lives here, not on the
/// group, so beans can come before flavour on a coffee while extras come
/// first on a sandwich — without duplicating the groups themselves.
model MenuItemOptionGroup {
  menuItemId String
  groupId    String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  displayOrder Int @default(0)

  @@id([menuItemId, groupId])
  @@index([groupId])
}

/// Exactly which choices one item offers.
///
/// An attached group supplies the question ("which beans?"); this table
/// supplies that item's answers. Nothing is offered until it is ticked, so a
/// group can be reused across items that share only some of its choices —
/// Extras carries fries, but a croissant never offers them.
///
/// The trade-off, deliberately taken: a choice added to a group later appears
/// on no item until someone ticks it. That is the price of "nothing is on the
/// menu unless I put it there", which is the safer default for a café — a
/// choice that silently appears on every item is how a customer is offered
/// something the kitchen cannot make.
model MenuItemOptionChoice {
  menuItemId String
  optionId   String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  option     Option   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([menuItemId, optionId])
  @@index([optionId])
}

// ------------------------------------------------------------
//  ADMIN
// ------------------------------------------------------------

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  lastLoginAt  DateTime?

  /// --- Two-factor (TOTP) ---
  /// Base32 shared secret. Present but unconfirmed while setup is in progress;
  /// only enforced once totpEnabledAt is set.
  totpSecret    String?
  totpEnabledAt DateTime?
  /// Single-use recovery codes, stored hashed. Consumed on use.
  backupCodes   BackupCode[]
  resetTokens   PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, short-lived password reset tokens.
/// Only a hash is stored — a leaked database row cannot be used to reset.
model PasswordResetToken {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, createdAt])
  @@index([expiresAt])
}

model BackupCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  /// SHA-256 of the code. The plaintext is shown once, at generation.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

// ------------------------------------------------------------
//  SITE CONTENT — single row, edited from the dashboard
// ------------------------------------------------------------

model SiteSettings {
  id String @id @default("singleton")

  heroHeadline String  @default("Patience tastes better")
  heroSubcopy  String  @default("Proved slowly. Baked the same morning it's served.")
  heroImageUrl String?
  heroVideoUrl String?

  storyTitle    String  @default("Daar means home")
  storyBody     String  @default("")
  storyImageUrl String?

  /// Photo on the Visit and Reserve pages.
  visitImageUrl String?

  /// --- The home page's own backdrops ---
  /// Each of these used to borrow another page's photo: the three sliding
  /// panels took the story, hero and visit images, and so did the closing
  /// band. Changing the Visit page therefore changed the home page, which
  /// nobody could have guessed from the dashboard. They now stand alone, and
  /// fall back to the same brand artwork as before when unset.
  ///
  /// Any of these may hold a video rather than a photograph — see
  /// src/lib/media.ts. The built-in default is the still frame underneath.
  /// The three sliding panels moved to the HomePanel table below, because
  /// their words had nowhere to live as columns and splitting one panel's
  /// picture from its sentence across two screens of the dashboard is how
  /// nobody finds either. Their photographs came with them.
  /// The "Come and see" band at the foot of the home page.
  closingImageUrl String?
  /// The arch beside "Daar means home" on the home page — distinct from
  /// storyImageUrl, which is the Story page's own photograph.
  storyBandImageUrl String?

  /// --- Every fixed label on the home page ---
  /// These were written into src/app/page.tsx, so correcting a word meant a
  /// developer and a deploy. Defaults are exactly what the page used to say,
  /// so nothing moves until the cafe changes it.
  heroEyebrow        String  @default("")
  heroPrimaryLabel   String  @default("Explore the menu")
  heroSecondaryLabel String  @default("Find us")

  counterEyebrow String @default("On the counter")
  counterHeading String @default("What today looks like")

  chefEyebrow   String @default("From the kitchen")
  featuredBadge String @default("Chef's Special")

  storyEyebrow String @default("Our story")

  closingEyebrow String @default("Come and see")
  closingHeading String @default("")

  visitEyebrow String @default("Come in")
  visitHeading String @default("Visit")

  /// "sm" | "md" | "lg" | "xl" — the size of every section heading on the
  /// home page. One control rather than nine, so the page stays consistent.
  homeHeadingSize String @default("lg")

  /// --- "What we stand for", on the home page ---
  /// The section's own wording and sizing. The cards themselves are rows in
  /// ValueCard below, because there is no fixed number of them.
  ///
  /// These are columns rather than constants in the page source for the
  /// reason every other field here is: the person who needs to change a
  /// heading is the cafe, and they must not need a deploy to do it.
  standForEnabled  Boolean @default(true)
  standForEyebrow  String  @default("Why we do it this way")
  standForHeading  String  @default("What we stand for")
  /// "sm" | "md" | "lg" | "xl" — how large the section heading is set.
  standForHeadingSize String @default("lg")
  /// "sm" | "md" | "lg" — the width of the cards and the size of type on them.
  standForCardSize    String @default("md")

  /// --- The chef, on the home page ---
  /// Words published under a named person, so they belong in the dashboard
  /// where that person can approve and change them — not in the page source.
  /// Blank name or quote hides the section rather than printing a placeholder
  /// attributed to somebody real.
  chefName     String?
  chefRole     String? @default("Executive Chef")
  chefQuote    String?
  chefImageUrl String?

  /// Browser-tab icon. Falls back to the door mark when unset.
  faviconUrl String?

  /// Brand artwork uploaded from the dashboard. Takes precedence over any
  /// file dropped into public/brand/logo/, which in turn beats the traced mark.
  logoMarkUrl     String?
  logoWordmarkUrl String?

  addressLine String  @default("Nairobi, Kenya")
  mapEmbedUrl String?

  /// Fed straight into the Restaurant structured data, which is what builds
  /// Google's business panel. Coordinates come from right-clicking the pin in
  /// Google Maps; priceRange is the "$$" style band, not a number.
  latitude   String?
  longitude  String?
  priceRange String?
  phone      String?
  whatsapp   String?
  email      String?

  /// Where booking requests are emailed, when that is not the same inbox as
  /// general enquiries. Blank means they go to `email` like everything else.
  reservationsEmail String?

  /// { instagram, tiktok, facebook, ... }
  socials Json @default("{}")

  /// Single config value so switching currency is a one-line change.
  currency String @default("KES")

  /// Reservations
  reservationsEnabled Boolean @default(true)
  maxPartySize        Int     @default(12)
  /// Shown above the booking form, e.g. "Groups over 8, please call us."
  reservationNote     String?

  updatedAt DateTime @updatedAt
}

model OpeningHours {
  id        String  @id @default(cuid())
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek Int     @unique
  openTime  String? // "07:00"
  closeTime String? // "21:00"
  isClosed  Boolean @default(false)
}

/// The photo grid on the Story page. Editable from the dashboard.
model StoryPhoto {
  id           String   @id @default(cuid())
  imageUrl     String
  imageAlt     String?
  blurDataUrl  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([displayOrder])
}

/// The drifting band of plates on the home page ("What today looks like").
///
/// Empty by design at first: with no rows the band falls back to picking
/// menu photographs at random, which is what it did before it could be
/// edited. Add a single row and the band shows exactly what was chosen —
/// so curating it is opt-in, and a café that never opens this section keeps
/// a band that fills itself.
model HomePhoto {
  id           String   @id @default(cuid())
  imageUrl     String
  imageAlt     String?
  blurDataUrl  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([displayOrder])
}

/// One of the full-screen panels that slide up over each other on the home
/// page, just below the hero.
///
/// A table rather than three sets of columns on SiteSettings: the sentences
/// had no columns at all and were written into the page, while the pictures
/// were columns — so half a panel was editable and half needed a deploy.
/// Rows also mean the cafe can run two panels one season and four the next.
///
/// `imageUrl` may hold a film as well as a photograph, exactly as the columns
/// it replaces did — see src/lib/media.ts.
model HomePanel {
  id      String  @id @default(cuid())
  /// Small label above the sentence. Blank on most panels.
  eyebrow String  @default("")
  /// The sentence itself — the whole point of the panel.
  line    String

  imageUrl    String?
  imageAlt    String?
  blurDataUrl String?

  /// Up to two links, for the panel that carries them. Both halves must be
  /// filled in for a link to render; a label with no address is not a link.
  linkOneLabel String @default("")
  linkOneHref  String @default("")
  linkTwoLabel String @default("")
  linkTwoHref  String @default("")

  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

/// One card in the home page's "What we stand for" strip.
///
/// `body` holds the lines as entered, newline-separated, and the public
/// component sets each line on its own — that is the look, and asking the
/// cafe to fill in three separate "line" fields to get it would be a worse
/// dashboard for the same result.
///
/// isVisible rather than deleting: a card taken down for a season should not
/// mean retyping it and re-uploading its photograph in three months.
model ValueCard {
  id           String   @id @default(cuid())
  title        String
  body         String   @default("")
  imageUrl     String?
  imageAlt     String?
  blurDataUrl  String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([displayOrder])
}

// ------------------------------------------------------------
//  RESERVATIONS
//  Requests, not confirmations — the owner approves each one from
//  the dashboard, so the café is never double-booked by the website.
// ------------------------------------------------------------

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id String @id @default(cuid())

  /// Required: enough to hold, confirm and call back about a table.
  name      String
  phone     String
  email     String
  partySize Int
  date      DateTime @db.Date
  time      String // "19:30" — matched against OpeningHours

  /// Optional extras.
  occasion String?
  notes    String?

  status      ReservationStatus @default(PENDING)
  /// Free-text note the owner adds when confirming or declining.
  adminNote   String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, time])
  @@index([status, date])
  @@index([createdAt])
}

// ------------------------------------------------------------
//  MESSAGES
//  "Leave us a message" from the public site. Read and answered by the
//  owner from the dashboard; the site never replies automatically.
// ------------------------------------------------------------

enum MessageStatus {
  UNREAD
  READ
  ARCHIVED
}

model Message {
  id String @id @default(cuid())

  name    String
  email   String
  phone   String?
  subject String?
  body    String

  status    MessageStatus @default(UNREAD)
  /// Private note the owner adds after handling it.
  adminNote String?
  readAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  /// Supports the duplicate-submission guard.
  @@index([email, createdAt])
}

// ------------------------------------------------------------
//  ANALYTICS — aggregate only. No cookies, no visitor identity.
//  Raw events roll up nightly into DailyItemStat and are then pruned,
//  so the table cannot grow unbounded on a small VPS.
// ------------------------------------------------------------

enum ViewSource {
  MENU
  HOME
  DIRECT
}

model MenuItemView {
  id         String     @id @default(cuid())
  menuItemId String
  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  source     ViewSource @default(MENU)
  viewedAt   DateTime   @default(now())

  @@index([menuItemId, viewedAt])
  @@index([viewedAt])
}

model DailyItemStat {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  /// Midnight UTC of the day being counted.
  date       DateTime @db.Date
  views      Int      @default(0)

  @@unique([menuItemId, date])
  @@index([date])
}

model PageView {
  id    String   @id @default(cuid())
  path  String
  date  DateTime @db.Date
  views Int      @default(0)

  @@unique([path, date])
  @@index([date])
}
